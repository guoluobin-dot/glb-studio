# ── 依赖与构建产物 ──
node_modules/
dist/
out/
build/
*.tsbuildinfo

# 打包输出目录可能临时换名（比如原目录被杀毒软件锁住时用 --config.directories.output=dist-new）。
# 这些是几百 MB 的 Chromium 二进制，绝不能进版本库。
# 别只写 dist/ —— 换个名字就绕过了，踩过一次（git add -A 把 win-unpacked 全暂存了）。
dist*/

# ── 密钥：绝不能进版本库 ──
.env
.env.*
config/secrets.local.json
config/*.local.json

# 姓名脱敏映射表：本机自留，绝不能进仓库。
# 脚本本身要公开，所以真名只能待在这个被忽略的文件里。
scripts/sanitize-names.local.json

# ── 运行数据 ──
# 里面是逐句稿、抽帧、缓存
data/
logs/
*.log

# ── 上传的素材与成片（体积大，本机状态）──
upload/

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── 算法层副本里的本机状态 ──
hermes/data/
hermes/upload/
hermes/logs/
hermes/node_modules/
hermes/config/secrets.local.json
