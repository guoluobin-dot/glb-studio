{
  "server": {
    "port": 17841,
    "host": "127.0.0.1"
  },
  "ollama": {
    "baseUrl": "http://localhost:11434/v1",
    "chatModel": "qwen3:8b-chat",
    "lightModel": null,
    "visionModel": "qwen2.5vl:7b",
    "embeddingModel": "",
    "timeout": 600000,
    "temperature": 0.7,
    "maxTokens": 4096
  },
  "llm": {
    "provider": "auto"
  },
  "deepseek": {
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "apiKey": "{env:DEEPSEEK_API_KEY}",
    "timeout": 300000,
    "maxTokens": 8192,
    "temperature": 0.7
  },
  "zen": {
    "baseUrl": "https://opencode.ai/zen/v1",
    "model": "muse-spark-1.3-contributor-free",
    "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
    "allowCloud": false,
    "heavyEffort": "medium",
    "lightEffort": "low",
    "timeout": 180000,
    "maxTokens": 4096
  },
  "performance": {
    "idleGpuUtil": 25,
    "busyGpuUtil": 60,
    "maxConcurrentIdle": 3,
    "maxConcurrentBusy": 0,
    "maxConcurrentLlm": 1,
    "lightCtx": 8192,
    "heavyCtx": 8192,
    "visionCtx": 4096,
    "segmentChunkSeconds": 240,
    "matchBatchSize": 20,
    "llmMaxOutputTokens": 1200,
    "llmMaxOutputTokensCloud": 2000,
    "llmMaxOutputTokensLocal": 2400,
    "llmTimeoutMs": 600000,
    "prescreen": true,
    "prescreenMinChars": 260,
    "prescreenMinDensity": 1.6
  },
  "glb": {
    "webhookSecret": "hermes-local-secret",
    "outputWatchDir": "<GLB_ROOT>/output",
    "transcriptDir": "<GLB_ROOT>/output/transcripts",
    "highlightDir": "<GLB_ROOT>/output/highlights",
    "clipDir": "<GLB_ROOT>/output/clips",
    "exePath": "<GLB_ROOT>/GLB/GLB.exe",
    "userDataDirs": []
  },
  "memory": {
    "dbPath": "data/hermes.db",
    "vectorDimensions": 4096,
    "similarityThreshold": 0.75,
    "maxMemoryEntries": 100000
  },
  "copywriting": {
    "presetPath": "data/copywriting-presets.json",
    "extractionModel": "qwen3:8b-chat",
    "maxHooksPerVideo": 5,
    "maxCTAsPerVideo": 3
  },
  "highlight": {
    "minConfidence": 0.5,
    "learningRate": 0.15,
    "patternWindowSize": 30000,
    "minSamplesForPattern": 3
  },
  "watch": {
    "enabled": true,
    "ignoreInitial": true,
    "awaitWriteFinish": {
      "stabilityThreshold": 2000,
      "pollInterval": 500
    }
  },
  "upload": {
    "hitsDir": "<GLB_ROOT>/Hermes/upload/hits",
    "liveDir": "<GLB_ROOT>/Hermes/upload/live",
    "tempDir": "<GLB_ROOT>/Hermes/upload/temp",
    "retentionDays": 7,
    "maxFileBytes": 8589934592,
    "maxTotalBytes": 53687091200
  },
  "output": {
    "finishedDir": "<GLB_ROOT>/output/finished",
    "draftDir": "<GLB_ROOT>/output/draft"
  },
  "analyzer": {
    "ffmpegPath": "",
    "keyframeThreshold": 0.3,
    "minSegmentDurationMs": 30000,
    "maxSegmentDurationMs": 180000,
    "termCorrect": true
  },
  "clipper": {
    "minHookQuality": 0.6,
    "maxClipsPerLive": 10,
    "targetClipDurationMs": 60000,
    "_durationNote": "成片时长控制（2026-09-28）。以前提示词里写死 30-90 秒且 targetClipDurationMs 从不生效，成片多长全看模型心情。现在按选题档位推导，也可直接指定秒数。优先级：targetClipDurationSec > durationPreset > 默认 point。",
    "durationPreset": "point",
    "_presetNote": "档位（秒）：point 单一技巧点=50 / compare 技巧+错误对比=240 / song 单曲拆解=480 / lesson 整节课=780。档位值来自老板 15 条爆款素材的实际分布（0.8~0.9分 / 3.7~4.4分 / 6.3~8.8分 / 11~15分）。",
    "targetClipDurationSec": null,
    "clipDurationMinSec": null,
    "clipDurationMaxSec": null,
    "autoTrimToTarget": true,
    "autoConfirmTimeoutMs": 1800000,
    "visionReview": true,
    "visionWeakThreshold": 0.35,
    "visionMaxFrames": 8
  },
  "generator": {
    "titleFontSize": 48,
    "titleFontColor": "#FFFFFF",
    "titleBgColor": "#FF6B35",
    "subtitleFontSize": 32,
    "coverTemplate": "default",
    "coverCandidates": 6,
    "coverSpanSeconds": 30,
    "subtitleCorrect": true
  },
  "scheduler": {
    "enabled": true,
    "scanIntervalMs": 30000,
    "maxConcurrentTasks": 2,
    "transcribeOnBusy": true,
    "priorityFirst": true
  },
  "logging": {
    "level": "info",
    "file": "data/hermes.log"
  },
  "gemini": {
    "apiKey": "{env:GEMINI_API_KEY}",
    "model": "gemini-3.5-flash-lite",
    "baseUrl": "https://api.apimart.ai/v1",
    "timeout": 600000,
    "maxTokens": 16384,
    "temperature": 0.6,
    "cloudBudgetPerRun": 8,
    "protocol": "openai-compatible",
    "auth": "bearer"
  },
  "security": {
    "extraAllowedDirs": [
      "<USER_VIDEOS>/GLB",
      "<GLB_ROOT>/output",
      "<GLB_ROOT>/GLBUserData",
      "E:/"
    ]
  }
}
