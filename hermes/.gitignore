# ── 密钥：绝不能进版本库 ──
# config/default.json 里只留 {env:NAME} 占位符，真实值放这个被忽略的文件
config/secrets.local.json

# ── 运行时生成的密钥（webhook 密钥在首次启动时自动生成到 data/.hermes-secret）──
data/.hermes-secret

# ── 运行数据：库、逐句稿缓存、抽帧、日志、上传的素材 ──
# 这些都是本机状态、体积大（几个 GB），换机器应该重新生成而不是拷过去
data/
upload/
logs/

# ── data/ 里跟源码走的配置，必须跟着仓库走 ──
# 上面 data/ 整目录被忽略，下面要显式放行这些文件。
# Git 不会进入被忽略的目录，所以这里必须先放行目录本身再放行文件。
!data/
data/*
!data/clip-rules.json
!data/clip-standard.json
!data/copywriting-presets.json
!data/theme-taxonomy.json
data/.hermes-secret

# ── 依赖与构建产物 ──
node_modules/
dist/
build/
*.log

# ── 本地覆盖配置 ──
.env
.env.*
config/default.local.json
config/*.local.json

# ── 编辑器与系统 ──
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store